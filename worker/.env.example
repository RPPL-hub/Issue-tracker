# The deployed app's WhatsApp webhook endpoint.
WEBHOOK_URL="https://issues.rwenzori.in/api/whatsapp/webhook"

# Must exactly match WHATSAPP_WEBHOOK_SECRET set on the app (Vercel).
WEBHOOK_SECRET=""

# Optional: only forward this group's messages (its id ends with @g.us).
# Leave empty at first; the worker logs the id when a group message arrives,
# then set it here (and on the app) and restart.
WHATSAPP_GROUP_ID=""

# Optional: folder holding the WhatsApp linked-device session. Keep it private
# and persistent — it's what keeps the bot logged in. (default: auth_info)
# AUTH_DIR="auth_info"

# Optional: log verbosity — warn | info | debug (default: warn)
# LOG_LEVEL="warn"
