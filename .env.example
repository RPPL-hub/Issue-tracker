# PostgreSQL connection string (the app uses a free Neon database in production).
#
# Get this from your Neon project dashboard -> "Connection string".
# Tip: use the DIRECT (non-pooled) connection string here — it works for both
# applying the schema and running the app.
#
# Format:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#
# Example (Neon):
#   DATABASE_URL="postgresql://rpl_owner:abc123@ep-cool-name-123456.eu-central-1.aws.neon.tech/rpl?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
