# --- Local development (zero setup) ---
# SQLite stores the database in a single file on disk. Nothing else to install.
DATABASE_URL="file:./dev.db"

# --- Production (when you deploy) ---
# For a host with a persistent disk (Railway / Render disk / a VPS / Fly volume),
# point this at a file on that disk, e.g.:
#   DATABASE_URL="file:/data/rpl.db"
#
# For a serverless host (Vercel), use a hosted Postgres connection string instead
# (see DEPLOY.md for the one-line schema change), e.g.:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
