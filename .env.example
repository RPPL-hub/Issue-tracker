# PostgreSQL connection string (the app uses a free Neon database in production).
#
# Get this from your Neon project dashboard -> "Connection string".
# Tip: use the DIRECT (non-pooled) connection string here — it works for both
# applying the schema and running the app.
#
# Format:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#
# Example (Neon):
#   DATABASE_URL="postgresql://rpl_owner:abc123@ep-cool-name-123456.eu-central-1.aws.neon.tech/rpl?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- WhatsApp → AI pipeline (optional; see WHATSAPP.md) ----

# Claude API key (console.anthropic.com) — powers issue detection/extraction.
ANTHROPIC_API_KEY=""
# Model for classification. Default keeps costs at ~a fraction of a cent/message.
# ANTHROPIC_MODEL="claude-haiku-4-5"

# Shared secret the gateway must present (?token=... or x-webhook-token header).
# Generate one with: openssl rand -hex 24
WHATSAPP_WEBHOOK_SECRET=""

# Whapi.Cloud channel token — lets the bot post "✅ Logged as RPL-xxx" replies.
WHAPI_TOKEN=""

# Only listen to this group (chat id like 1203...@g.us). If unset, the bot
# processes every group chat its number is a member of.
WHATSAPP_GROUP_ID=""

# Minimum classifier confidence (0-1) before a message becomes an issue.
# WHATSAPP_MIN_CONFIDENCE="0.7"

# Public URL of the app — used to include issue links in group confirmations.
# APP_BASE_URL="https://issues.rwenzori.in"
