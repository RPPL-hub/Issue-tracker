// Rwenzori Process Issue Tracker (RPL) — data model
// Persistent storage so every issue, status change, and comment is retained.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev uses SQLite (a single file). To deploy on a serverless host,
  // change this to "postgresql" and update DATABASE_URL. See DEPLOY.md.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Issue {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  priority    String    @default("Medium") // Critical | High | Medium | Low
  department  String    @default("Operations") // Operations | Logistics | Quality | IT | Admin
  status      String    @default("Open") // Open | In Progress | Resolved
  reportedBy  String
  assignedTo  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([status])
  @@index([priority])
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  author    String
  createdAt DateTime @default(now())

  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId Int

  @@index([issueId])
}
